@rendermode InteractiveServer
@inject IJSRuntime JS
@inject MarketDataHub Market
@implements IDisposable

<div class="chart-wrap" style="display:flex;flex-direction:column;height:100%">
    <div style="display:flex;gap:8px;padding:6px 8px;border-bottom:1px solid var(--border);align-items:center;flex-wrap:wrap">
        @foreach (var ex in _lines)
        {
            <label style="display:flex;align-items:center;gap:4px;cursor:pointer;font-size:10px;color:@(ex.On?"var(--cyan)":"var(--text-dim)")">
                <input type="checkbox" checked="@ex.On" @onchange="e => Toggle(ex, e)" />
                <span style="width:8px;height:8px;border-radius:50%;background:@ex.Color;display:inline-block"></span>
                @ex.Name
            </label>
        }
        <span style="margin-left:8px;font-size:10px;color:var(--text-muted)">Overlay LIVE</span>
        <span style="margin-left:auto;font-family:var(--mono);font-size:12px;font-weight:600;color:var(--lime)">@_lastPrice</span>
    </div>
    <div style="flex:1;min-height:0;position:relative">
        <canvas @ref="_canvas" style="width:100%;height:100%;display:block"></canvas>
    </div>
</div>

@code {
    [Parameter] public string Symbol { get; set; } = "BTCUSDT";

    ElementReference _canvas;
    string _lastPrice = "—";
    bool _ready;

    sealed class LineState
    {
        public string Name = "";
        public ExchangeType Exchange;
        public string Color = "#fff";
        public bool On;
        public List<(long T, double P)> Points = new();
    }

    readonly List<LineState> _lines = new()
    {
        new() { Name = "Binance", Exchange = ExchangeType.Binance, Color = "#f0b90b", On = true },
        new() { Name = "Bybit", Exchange = ExchangeType.Bybit, Color = "#f7a600", On = true },
        new() { Name = "OKX", Exchange = ExchangeType.Okx, Color = "#8888cc", On = true },
        new() { Name = "Gate", Exchange = ExchangeType.Gate, Color = "#17e6a1", On = true },
    };

    protected override async Task OnInitializedAsync()
    {
        Market.OnTrade += OnTrade;
        foreach (var line in _lines.Where(l => l.On))
            await Market.SubscribeAsync(line.Exchange, Symbol, true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ready = true;
            await DrawAsync();
        }
    }

    void OnTrade(string key, TradeTick t)
    {
        var line = _lines.FirstOrDefault(l => l.Exchange == t.Exchange && l.On);
        if (line == null) return;
        if (!Symbol.Replace("-", "").Equals(t.Symbol.Replace("-", ""), StringComparison.OrdinalIgnoreCase)
            && !key.Contains(Symbol.Replace("-", ""), StringComparison.OrdinalIgnoreCase))
            return;

        var ts = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        line.Points.Add((ts, (double)t.Price));
        if (line.Points.Count > 250) line.Points.RemoveAt(0);
        if (t.Exchange == ExchangeType.Binance)
            _lastPrice = t.Price >= 1000 ? t.Price.ToString("N1") : t.Price.ToString("G6");

        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await DrawAsync();
        });
    }

    async Task Toggle(LineState ex, ChangeEventArgs e)
    {
        ex.On = e.Value is bool b && b;
        if (ex.On)
            await Market.SubscribeAsync(ex.Exchange, Symbol, true);
        await DrawAsync();
    }

    async Task DrawAsync()
    {
        if (!_ready) return;
        var series = _lines.Where(x => x.On && x.Points.Count > 1)
            .Select(x => new { name = x.Name, color = x.Color, points = x.Points.Select(p => new { t = p.T, p = p.P }).ToArray() })
            .ToArray();
        try { await JS.InvokeVoidAsync("hypeChart.drawOverlay", _canvas, series); }
        catch { /* js */ }
    }

    public void Dispose() => Market.OnTrade -= OnTrade;
}
