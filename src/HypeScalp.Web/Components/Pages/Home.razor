@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="workspace" id="workspace">
    <!-- Watchlist -->
    <div class="win active" style="left:8px;top:8px;width:240px;height:420px">
        <div class="win-header">
            <div class="win-title">SCREENER</div>
        </div>
        <div class="win-body" style="overflow:auto">
            @foreach (var p in _pairs)
            {
                <div style="display:grid;grid-template-columns:1fr 60px;padding:7px 10px;border-bottom:1px solid var(--border);cursor:pointer"
                     @onclick="() => Select(p.Sym)">
                    <div>
                        <div style="font-weight:600">@p.Sym</div>
                        <div style="font-size:9px;color:var(--text-muted)">@p.Ex</div>
                    </div>
                    <div style="text-align:right;font-family:var(--mono);color:@(p.Chg.StartsWith("+")?"var(--lime)":"var(--magenta)")">@p.Chg</div>
                </div>
            }
        </div>
    </div>

    <!-- Multi overlay chart -->
    <div class="win" style="left:260px;top:8px;width:640px;height:280px">
        <div class="win-header">
            <div class="win-title">@_symbol <span class="badge">MULTI OVERLAY · LIVE</span></div>
        </div>
        <div class="win-body">
            <ChartOverlay Symbol="@_symbol" />
        </div>
    </div>

    <!-- Live DOM BTC -->
    <div class="win" style="left:260px;top:300px;width:360px;height:400px">
        <div class="win-header">
            <div class="win-title">BTCUSDT <span class="badge">BINANCE WS</span></div>
        </div>
        <div class="win-body">
            <DomPanel Symbol="BTCUSDT" Futures="true" />
        </div>
    </div>

    <!-- Live DOM ETH -->
    <div class="win" style="left:630px;top:300px;width:360px;height:400px">
        <div class="win-header">
            <div class="win-title">ETHUSDT <span class="badge">BINANCE WS</span></div>
        </div>
        <div class="win-body">
            <DomPanel Symbol="ETHUSDT" Futures="true" />
        </div>
    </div>

    <!-- Positions -->
    <div class="win" style="left:1000px;top:8px;width:280px;height:280px">
        <div class="win-header">
            <div class="win-title">POSITIONS</div>
        </div>
        <div class="win-body" style="overflow:auto;padding:8px;color:var(--text-muted);font-size:11px">
            Connect API key in Connections to load account positions.
        </div>
    </div>
</div>

@code {
    string _symbol = "BTCUSDT";
    record Pair(string Sym, string Ex, string Chg);
    List<Pair> _pairs = new()
    {
        new("BTCUSDT","Binance","+1.24%"),
        new("ETHUSDT","Bybit","+0.87%"),
        new("SOLUSDT","OKX","-0.42%"),
        new("BNBUSDT","Binance","+0.31%"),
        new("XRPUSDT","Bybit","+2.15%"),
        new("AVAXUSDT","Bitget","+1.92%"),
        new("NEARUSDT","MEXC","+3.41%"),
    };

    async Task Select(string sym)
    {
        _symbol = sym;
        await JS.InvokeVoidAsync("showToast", $"Focus · {sym}");
    }
}
