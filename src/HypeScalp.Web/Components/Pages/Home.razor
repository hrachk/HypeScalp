@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="workspace" id="workspace">
    <div class="win active" data-win="screener" style="left:8px;top:8px;width:240px;height:420px">
        <div class="win-header">
            <div class="win-title">SCREENER</div>
        </div>
        <div class="win-body" style="overflow:auto">
            @foreach (var p in _pairs)
            {
                <div style="display:grid;grid-template-columns:1fr 60px;padding:7px 10px;border-bottom:1px solid var(--border);cursor:pointer"
                     @onclick="() => Select(p.Sym)">
                    <div>
                        <div style="font-weight:600">@p.Sym</div>
                        <div style="font-size:9px;color:var(--text-muted)">@p.Ex</div>
                    </div>
                    <div style="text-align:right;font-family:var(--mono);color:@(p.Chg.StartsWith("+")?"var(--lime)":"var(--magenta)")">@p.Chg</div>
                </div>
            }
        </div>
    </div>

    <div class="win" data-win="chart" style="left:260px;top:8px;width:640px;height:280px">
        <div class="win-header">
            <div class="win-title">@_symbol <span class="badge">MULTI OVERLAY</span></div>
            <button class="win-btn" title="Save layout" @onclick="SaveLayout">💾</button>
        </div>
        <div class="win-body">
            <ChartOverlay Symbol="@_symbol" @key="_symbol" />
        </div>
    </div>

    <div class="win" data-win="dom-binance" style="left:260px;top:300px;width:340px;height:400px">
        <div class="win-header">
            <div class="win-title">BTCUSDT <span class="badge">BINANCE</span></div>
        </div>
        <div class="win-body">
            <DomPanel Symbol="BTCUSDT" Exchange="ExchangeType.Binance" Futures="true" />
        </div>
    </div>

    <div class="win" data-win="dom-bybit" style="left:610px;top:300px;width:340px;height:400px">
        <div class="win-header">
            <div class="win-title">ETHUSDT <span class="badge">BYBIT</span></div>
        </div>
        <div class="win-body">
            <DomPanel Symbol="ETHUSDT" Exchange="ExchangeType.Bybit" Futures="true" />
        </div>
    </div>

    <div class="win" data-win="dom-okx" style="left:960px;top:8px;width:300px;height:280px">
        <div class="win-header">
            <div class="win-title">BTC-USDT <span class="badge">OKX</span></div>
        </div>
        <div class="win-body">
            <DomPanel Symbol="BTC-USDT" Exchange="ExchangeType.Okx" Futures="true" />
        </div>
    </div>

    <div class="win" data-win="dom-gate" style="left:960px;top:300px;width:300px;height:400px">
        <div class="win-header">
            <div class="win-title">BTC_USDT <span class="badge">GATE</span></div>
        </div>
        <div class="win-body">
            <DomPanel Symbol="BTC_USDT" Exchange="ExchangeType.Gate" Futures="true" />
        </div>
    </div>
</div>

@code {
    string _symbol = "BTCUSDT";
    record Pair(string Sym, string Ex, string Chg);
    List<Pair> _pairs = new()
    {
        new("BTCUSDT","Binance","live"),
        new("ETHUSDT","Bybit","live"),
        new("SOLUSDT","OKX","—"),
        new("BNBUSDT","Binance","—"),
        new("XRPUSDT","Bybit","—"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("hypeLayout.restore");
    }

    async Task Select(string sym)
    {
        _symbol = sym.Replace("-", "");
        await JS.InvokeVoidAsync("showToast", $"Chart · {_symbol}");
    }

    async Task SaveLayout()
    {
        await JS.InvokeVoidAsync("hypeLayout.save");
        await JS.InvokeVoidAsync("showToast", "Layout saved");
    }
}
